7m--json\u001b[39m flag and a test for the JSON line.                                             \u001b[0m\u001b]8;;\u0007\u001b[16;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[17;1H\u001b[2K \u001b[0;38;2;240;198;116;1m03\u001b[0m \u001b[0;38;2;255;255;0;48;2;22;22;31m● \u001b[0;48;2;22;22;31;1mEdit\u001b[0;48;2;22;22;31m \u001b[0;38;2;92;200;187;48;2;22;22;31msrc/main.rs\u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[18;1H\u001b[2K   \u001b[0;38;2;168;168;168m┊\u001b[0m  \u001b[0;48;2;22;22;31m  \u001b[0;38;2;168;168;168;48;2;22;22;31m 21\u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[19;1H\u001b[2K   \u001b[0;38;2;168;168;168m┊\u001b[0m  \u001b[0;48;2;22;22;31m  \u001b[0;38;2;181;189;104;48;2;22;22;31m+22 /// The counts as one line of JSON, e.g. `{\"lines\":2,\"words\":3}`.\u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[20;1H\u001b[2K   \u001b[0;38;2;168;168;168m┊\u001b[0m  \u001b[0;48;2;22;22;31m  \u001b[0;38;2;181;189;104;48;2;22;22;31m+23 pub fn to_json(counts: &Counts) -> String {\u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[21;1H\u001b[2K   \u001b[0;38;2;168;168;168m┊\u001b[0m  \u001b[0;38;2;152;152;152m… 53 more lines\u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[23;1H\u001b[2K \u001b[38;2;168;168;168m\u001b[39m                                                                                                                    \u001b[0m\u001b]8;;\u0007\u001b[24;1H\u001b[2K\u001b[0;38;2;168;168;168m┊\u001b[0m \u001b[0;38;2;92;200;187m◉\u001b[0m \u001b[0;1mReading the stats command\u001b[0m                                                                                    \u001b[0;38;2;168;168;168m5.8s\u001b[0m\u001b]8;;\u0007\u001b[25;1H\u001b[2K\u001b[0;38;2;168;168;168m┊\u001b[0m \u001b[0;38;2;168;168;168m○\u001b[0m \u001b[0;38;2;152;152;152mAdd a --json flag that prints the counts as JSON\u001b[0m\u001b[0m\u001b]8;;\u0007\u001b[26;1H\u001b[2K\u001b[0;38;2;168;168;168m┊\u001b[0m \u001b[0;38;2;168;168;168m○\u001b[0m \u001b[0;38;2;152;152;152mCover the JSON output with a unit test\u001b[0m\u0